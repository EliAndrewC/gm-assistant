#!/usr/bin/python3 -I
"""user-systemctl - read-only `systemctl --user` for the claude-diag account.

Installed root-owned at /usr/local/libexec/claude-diag/user-systemctl and run as the HOST USER
(eli) through sudo, because the user manager (where rootless podman parents each container's
scope, under claude-containers.slice) answers only its own user:

    sudo -u eli /usr/local/libexec/claude-diag/user-systemctl show claude-containers.slice -p MemoryCurrent

System-wide units need none of this: `systemctl status systemd-oomd` works unprivileged.

Why a wrapper: systemctl's own options include -H/--host (runs ssh AS ELI, with eli's keys) and
-M/--machine, and verbs include start/stop/set-property. This allows named read verbs and named
options, always prepends --user --no-pager, and refuses everything else. A flag's value may not
start with "-".
"""

import os
import pwd
import re
import sys

SYSTEMCTL = "/usr/bin/systemctl"

VERBS = {
    "show",
    "status",
    "cat",
    "list-units",
    "list-timers",
    "list-sockets",
    "list-unit-files",
    "is-active",
    "is-failed",
    "is-enabled",
}
BOOL_FLAGS = {
    "-a",
    "--all",
    "--full",
    "-l",
    "--value",
    "--plain",
    "--no-legend",
    "--failed",
    "-q",
    "--quiet",
    "--recursive",
    "-r",
}
VALUE_FLAGS = {"-p", "--property", "-P", "-t", "--type", "--state", "-n", "--lines", "-o", "--output"}

UNIT = re.compile(r"^[A-Za-z0-9@._:\\*\[\]][A-Za-z0-9@._:\\*\[\]-]*$")


def validate(argv: list[str]) -> list[str]:
    """Return argv unchanged if every word is allowed, else raise ValueError naming the word."""
    if not argv or argv[0] not in VERBS:
        raise ValueError(f"verb not allowed (allowed: {', '.join(sorted(VERBS))})")
    rest = argv[1:]
    i = 0
    while i < len(rest):
        word = rest[i]
        if word.startswith("-"):
            name, eq, value = word.partition("=")
            if name in BOOL_FLAGS:
                if eq:
                    raise ValueError(f"{word}: a boolean flag takes no value")
            elif name in VALUE_FLAGS:
                if not eq:
                    i += 1
                    if i == len(rest):
                        raise ValueError(f"{word}: missing value")
                    value = rest[i]
                if value.startswith("-"):
                    raise ValueError(f"{word}: a value may not start with '-'")
            else:
                raise ValueError(f"flag not allowed: {word}")
        elif not UNIT.match(word):
            raise ValueError(f"not a unit name or pattern: {word!r}")
        i += 1
    return argv


def main() -> None:
    if os.getuid() == 0:
        sys.exit("user-systemctl: run as the host user (sudo -u <user>), not as root")
    try:
        argv = validate(sys.argv[1:])
    except ValueError as err:
        sys.exit(f"user-systemctl: {err}")
    pw = pwd.getpwuid(os.getuid())
    env = {
        "HOME": pw.pw_dir,
        "USER": pw.pw_name,
        "LOGNAME": pw.pw_name,
        "PATH": "/usr/sbin:/usr/bin:/sbin:/bin",
        "LANG": "C.UTF-8",
        "SYSTEMD_PAGER": "",
        "XDG_RUNTIME_DIR": f"/run/user/{pw.pw_uid}",
        "DBUS_SESSION_BUS_ADDRESS": f"unix:path=/run/user/{pw.pw_uid}/bus",
    }
    os.execve(SYSTEMCTL, [SYSTEMCTL, "--user", "--no-pager", *argv], env)


if __name__ == "__main__":
    main()
