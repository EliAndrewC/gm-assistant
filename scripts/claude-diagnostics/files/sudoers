# Installed at /etc/sudoers.d/claude-diag (0440) by grant-claude-diagnostics.sh, with @HOST_USER@
# filled in, after `visudo -cf` accepts it.
#
# Everything claude-diag may run with sudo. Each wrapper is root-owned under
# /usr/local/libexec/claude-diag/ and validates its own arguments against an allowlist (see the
# header of each for why a sudoers wildcard is not enough). Reading the journal and most of
# /var/log needs no sudo at all: that comes from the systemd-journal and adm groups.

Defaults:claude-diag env_reset, !requiretty, secure_path="/usr/sbin:/usr/bin:/sbin:/bin"

# Rootless podman, read-only, as the user who owns the containers.
claude-diag ALL=(@HOST_USER@) NOPASSWD: /usr/local/libexec/claude-diag/podman-diag
# The user's systemd manager (container scopes, claude-containers.slice), read-only.
claude-diag ALL=(@HOST_USER@) NOPASSWD: /usr/local/libexec/claude-diag/user-systemctl
# The root-only files under /var/log.
claude-diag ALL=(root) NOPASSWD: /usr/local/libexec/claude-diag/varlog-read
# systemd-oomd's view of what it is watching and how close each cgroup is to a kill. Exactly
# these arguments (sudoers matches them literally).
claude-diag ALL=(root) NOPASSWD: /usr/bin/oomctl dump, /usr/bin/oomctl ""
