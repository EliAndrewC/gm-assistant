# Installed at /etc/systemd/system/claude-diag-ssh.socket by grant-claude-diagnostics.sh, with
# @HOST_USER@ / @HOST_HOME@ filled in.
#
# The socket lives in the host user's ~/.claude because launch-container.sh already bind-mounts
# that directory into every container (as /home/agent/.claude), so a running container can reach
# it at once: no network port, no new mount, no container restart. Mode 0600 owned by the host
# user: only that user's processes (and containers, whose agent maps to that user) can connect,
# and they still need the key in authorized_keys.
[Unit]
Description=Claude diagnostics sshd socket (Unix socket, no network)

[Socket]
ListenStream=@HOST_HOME@/.claude/host-diag/sshd.sock
SocketUser=@HOST_USER@
SocketGroup=@HOST_USER@
SocketMode=0600
Accept=yes
MaxConnections=8

[Install]
WantedBy=sockets.target
