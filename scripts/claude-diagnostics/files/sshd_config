# sshd config for the claude-diag account ONLY. Installed at /etc/claude-diag/sshd_config by
# grant-claude-diagnostics.sh; edit the copy in the repository and re-run the script.
#
# This sshd never listens on a network port. systemd hands it one connection at a time from a
# Unix socket (claude-diag-ssh.socket, `sshd -i`), so ListenAddress/Port do not apply, and the
# host's own ssh.service (if any) is untouched: this file does not Include /etc/ssh/sshd_config.d.

HostKey /etc/claude-diag/ssh_host_ed25519_key
AuthorizedKeysFile /etc/claude-diag/authorized_keys

AllowUsers claude-diag
PermitRootLogin no
AuthenticationMethods publickey
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitEmptyPasswords no
# No PAM: the account has no password ('*'), and PAM's session stack would only add motd scripts
# and a logind session per command.
UsePAM no

# Commands only: no forwarding of any kind, no tunnels, no file transfer subsystem.
DisableForwarding yes
PermitTunnel no
PermitUserEnvironment no
PermitTTY no
PrintMotd no
PrintLastLog no

LoginGraceTime 20
MaxAuthTries 2
MaxSessions 4
SyslogFacility AUTH
LogLevel INFO
