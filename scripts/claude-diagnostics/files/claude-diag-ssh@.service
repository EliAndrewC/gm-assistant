# Installed at /etc/systemd/system/claude-diag-ssh@.service by grant-claude-diagnostics.sh.
# One instance per connection accepted on claude-diag-ssh.socket.
[Unit]
Description=Claude diagnostics sshd (per connection)

[Service]
ExecStart=-/usr/sbin/sshd -i -f /etc/claude-diag/sshd_config
StandardInput=socket
StandardError=journal
RuntimeMaxSec=1h
