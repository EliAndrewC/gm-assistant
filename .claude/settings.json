{
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/gm-assistant/scripts/clone-sync-hooks.sh prompt",
            "timeout": 60,
            "statusMessage": "Syncing session clone with main..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/gm-assistant/scripts/clone-sync-hooks.sh pretool",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/gm-assistant/scripts/batching-hooks.sh pretool",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/gm-assistant/scripts/no-poll-hooks.sh pretool",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/gm-assistant/scripts/gate-hooks.sh pretool",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/gm-assistant/scripts/no-branch-hooks.sh pretool",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/gm-assistant/scripts/make-only-hooks.sh pretool"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/gm-assistant/scripts/guard-file-hooks.sh pretool"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/gm-assistant/scripts/batching-hooks.sh posttool",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
